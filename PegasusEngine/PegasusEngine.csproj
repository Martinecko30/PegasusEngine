<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0-windows</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AssimpNet" Version="5.0.0-beta1" />
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
      <PackageReference Include="OpenTK" Version="4.9.3" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="StbImageSharp" Version="2.30.15" />
      <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Resources\Models\cube.mtl" />
      <None Remove="Resources\Models\cube.obj" />
      <None Remove="Resources\Shaders\DefaultShader.frag" />
      <None Remove="Resources\Shaders\DefaultShader.vert" />
      <None Remove="Resources\Shaders\DepthShader.frag" />
      <None Remove="Resources\Shaders\DepthShader.vert" />
      <None Remove="Resources\Shaders\SkyboxShader.frag" />
      <None Remove="Resources\Shaders\SkyboxShader.vert" />
      <None Remove="Resources\Skybox\back.jpg" />
      <None Remove="Resources\Skybox\bottom.jpg" />
      <None Remove="Resources\Skybox\front.jpg" />
      <None Remove="Resources\Skybox\left.jpg" />
      <None Remove="Resources\Skybox\right.jpg" />
      <None Remove="Resources\Skybox\top.jpg" />
      <None Remove="Resources\Models\tree_forest.obj" />
      <None Remove="Resources\Models\tree_forest.mtl" />
      <None Remove="Resources\Images\BehaviourScriptLogo.png" />
      <None Remove="Resources\Images\FolderIcon.png" />
      <None Remove="Resources\Images\BehaviourScriptIcon.png" />
      <None Remove="Resources\Images\FileIcon.png" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="old\" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="PegasusEditor\res\EditorState.yml" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="PegasusEditor\res\Fonts\Font Awesome 7 Brands-Regular-400.otf" />
      <None Remove="PegasusEditor\res\Fonts\Font Awesome 7 Free-Regular-400.otf" />
      <None Remove="PegasusEditor\res\Fonts\Font Awesome 7 Free-Solid-900.otf" />
      <None Remove="PegasusEditor\res\Fonts\LICENSE.txt" />
      <None Remove="PegasusEditor\res\Fonts\NotoSans-variable.ttf" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="res\PegasusLogo.png" />
      <Content Include="res\PegasusLogo.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="res\PegasusLogo.svg" />
      <Content Include="res\PegasusLogo.svg">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="res\Shaders\DefaultShader.frag" />
      <Content Include="res\Shaders\DefaultShader.frag">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
      <None Remove="res\Shaders\DefaultShader.vert" />
      <Content Include="res\Shaders\DefaultShader.vert">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>

</Project>
