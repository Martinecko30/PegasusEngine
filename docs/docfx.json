{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "PegasusEngine.sln"
          ]
        }
      ],
      "dest": "api",
      "includeExplicitInterfaceImplementations": true,
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml"
        ],
        "exclude": [
          "_site/**"
        ]
      },
      {
        "files": [
          "*.md",
          "toc.yml",
          "docs/**.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "templates/singulinkfx"
    ],
    "globalMetadata": {
      "_appName": "PegasusEngine",
      "_appTitle": "PegasusEngine",
      "_enableSearch": true,
      "pdf": false
    }
  }
}